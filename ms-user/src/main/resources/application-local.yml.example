# 本地开发专用配置模板（提交本文件，仅模板）。
# 用法：复制本文件为 application-local.yml（该文件名已被 .gitignore 排除，不会提交），填入真实值。
# 本地启动无需设任何环境变量，默认 local profile 会加载 application-local.yml。
spring:
  data:
    redis:
      password: 你的Redis密码
  datasource:
    password: 你的数据库密码
jwt:
  secret: 至少32字节的随机密钥（可用 openssl rand -base64 48 生成）
